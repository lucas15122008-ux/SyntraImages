# Servidor apenas. Nunca use o prefixo NEXT_PUBLIC_ para a chave do OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=meta/muse-image

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Teto diário de gerações de imagem (toda a equipe)
DAILY_GENERATION_LIMIT=200

# Zip do kit: tamanho (600 a 3000 px) e formato (jpg ou png) das fotos. Padrão: 1600 e jpg.
DOWNLOAD_IMAGE_SIZE=1600
DOWNLOAD_IMAGE_FORMAT=jpg

# App do Mercado Livre (DevCenter). Servidor apenas: nunca use NEXT_PUBLIC_ aqui.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcional: a mesma URL de retorno cadastrada no app. Se vazio, usa <domínio>/api/ml/callback.
ML_REDIRECT_URI=
# Chave para criptografar os tokens no banco (mínimo 32 caracteres). Gere com: openssl rand -base64 48
ML_TOKEN_KEY=
