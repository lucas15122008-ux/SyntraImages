{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syntra",
  "version": "0.1.0",
  "identifier": "br.com.jrautopecas.syntra",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Fotos de anúncio para o Mercado Livre",
    "copyright": "JR Auto Peças",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
